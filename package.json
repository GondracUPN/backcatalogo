{
  "name": "catalogo-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "build": "npm install --include=dev --no-audit --no-fund && tsc -p tsconfig.json",
    "migration:run": "ts-node src/scripts/check-catalog-db.ts && ts-node ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "ts-node ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "migration:generate": "ts-node ./node_modules/typeorm/cli.js migration:generate -d src/data-source.ts src/migrations/Auto",
    "seed": "ts-node src/seed.ts",
    "test:catalog-p1": "ts-node src/tests/catalog-p1.test.ts",
    "test:availability": "ts-node src/tests/catalog-availability.test.ts",
    "test:smoke": "ts-node src/tests/validate-product.test.ts && ts-node src/tests/catalog-p1.test.ts && ts-node src/tests/perf-security.test.ts && npm run test:modules",
    "test:perf-security": "ts-node src/tests/perf-security.test.ts",
    "test:security-phase1": "ts-node src/tests/security-phase1.test.ts",
    "test:security-postgres": "ts-node src/tests/security-postgres.test.ts",
    "test:db:prepare": "ts-node src/scripts/prepare-security-test.ts",
    "db:check": "ts-node src/scripts/check-catalog-db.ts",
    "test:modules": "ts-node src/tests/themes.test.ts && ts-node src/tests/location-matching.test.ts && ts-node src/tests/purchase-requests.test.ts && ts-node src/tests/analytics.test.ts && ts-node src/tests/promotion-edit.test.ts && ts-node src/tests/review-fixes.test.ts && npm run test:photos && npm run test:photo-review && npm run test:sales-analytics && npm run test:sales-sync-edit",
    "test:photos": "ts-node src/tests/product-photos.test.ts",
    "audit:photo-urls": "ts-node src/scripts/audit-photo-urls.ts",
    "test:photo-review": "ts-node src/tests/photo-review.test.ts",
    "test:sales-analytics": "ts-node src/tests/sales-analytics.test.ts",
    "test:sales-sync-edit": "ts-node src/tests/sales-sync-edit.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "@types/node": "^20.12.12",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express-session": "^1.18.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express-session": "^1.18.0",
    "@types/jsonwebtoken": "^9.0.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
