DATABASE_URL=postgres://user:password@localhost:5432/mydb
SESSION_SECRET=change-me-session-secret
JWT_SECRET=change-me-jwt-secret
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-password
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# Sync + Revalidation
NEXT_BASE_URL=http://127.0.0.1:3000
CATALOG_SYNC_URL=http://127.0.0.1:3001/api/sync/product

# Upstream pull (optional) - manual/admin sync
UPSTREAM_API_BASE=http://127.0.0.1:3001
UPSTREAM_CATALOG_PATH=/catalog
UPSTREAM_STAGED_PATH=/admin/staged
# Optional auth
UPSTREAM_API_TOKEN=
UPSTREAM_AUTH_HEADER=Authorization
UPSTREAM_API_KEY=
# Set to 0 to disable upstream sync jobs
UPSTREAM_SYNC_ON_READ=1
# Extra staged searches used only by the explicit "solo tiendas pawn" sync.
# Useful for joined store names like "lambertpawnshop".
UPSTREAM_SYNC_SEARCH_TERMS=pawn,pawnshop,pawn shop
UPSTREAM_SYNC_SEARCH_PARAMS=q,search,seller,store,shop,tienda
# Optional tuning
UPSTREAM_SYNC_PAGE_SIZE=100
UPSTREAM_SYNC_MAX_PAGES=100
UPSTREAM_SYNC_EXISTING_CUTOFF=0

# Envio de ventas nuevas y anulaciones al backend de Servicios.
SERVICES_SALES_SYNC_URL=http://127.0.0.1:3001/integrations/catalog-sales/events

# Intervalo mínimo entre sincronizaciones automáticas en segundo plano (ms).
UPSTREAM_SYNC_MIN_INTERVAL_MS=60000

# Secreto compartido para /api/sync/* (servicios -> catálogo). Configúralo
# en ambos servicios antes de desplegar. Vacío rechaza todas las peticiones (503).
# También protege POST /admin/sales-sync/remote-status con x-sync-secret o Bearer.
CATALOG_SYNC_SECRET=
# Secreto para pedir al frontend que revalide la caché (/api/admin/revalidate).
REVALIDATE_SECRET=
# Secreto compartido con Next (/api/login) para reenviar la IP real del cliente al
# limitador de intentos de login. Mismo valor en Vercel y en la API. Vacío = todos
# los logins del panel comparten la IP del servidor de Next.
LOGIN_PROXY_SECRET=

# Fuera de producción solo se permite una base remota si su host coincide con este
# (p. ej. tu rama de desarrollo de Neon). Nunca pongas aquí el host de producción.
# ALLOWED_REMOTE_DATABASE_HOST=ep-xxxx-pooler.region.aws.neon.tech

# Desarrollo/pruebas: impide usar una base remota y desactiva integraciones.
# MACSO_TEST_DATABASE_URL=postgres://macso_test@127.0.0.1:55432/macsomenos_test
# MACSO_TEST_PASSWORD=<contraseña ficticia de al menos 12 caracteres>

# Fotos de vendidos: activar solo tras revisar el dry-run.
SOLD_PHOTO_CLEANUP_DAYS=60
SOLD_PHOTO_CLEANUP_ENABLED=false
SOLD_PHOTO_CLEANUP_DRY_RUN=true
# URL de Next accesible desde este backend; aloja Cloudinary/storage y revalida.
FRONTEND_INTERNAL_URL=http://127.0.0.1:3100

# Secreto exclusivo del borrado físico. Mismo valor en backend y Next/Vercel.
PHOTO_DELETE_SECRET=
